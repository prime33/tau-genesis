# streams/civic/example/endorsement_from_town_admin.tau — ILLUSTRATIVE (synthetic role, no real person)
stream: streams.civic.example.endorsement_from_town_admin

declare concept "stream_endorsement".
declare concept "endorsement_rationale".

clause_001 v0.1.0:
  define "stream_endorsement" as:
    a public affirmation emitted by town_admin in support of streams.policy.example.river_town_priority.

clause_002 v0.1.0:
  define "endorsement_rationale" as:
    endorses the stream as aligned with the town's health goals.

interface:
  provides: [stream_endorsement, endorsement_rationale]
  requires: [identity_trace, treatment_requirement]
